# Telegram API (my.telegram.org)
API_ID=
API_HASH=

# BotFather token for the bot account
BOT_TOKEN=

# Pyrogram string session for the assistant account that joins voice chats
SESSION_STRING=

# Your Telegram user id
OWNER_ID=

# Max track length allowed, in minutes
DURATION_LIMIT_MIN=60

# Firebase (Firestore) — used to remember served chats for /broadcast.
# Get this from Firebase Console > Project settings > Service accounts >
# Generate new private key. Provide EITHER a path to the downloaded file
# OR the raw JSON as one line — you don't need both.
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json
FIREBASE_CREDENTIALS_JSON=

# Meow API — used to fetch audio/video streams. Get a key from
# @MeowApiRobot on Telegram.
MEOW_API_URL=https://music.yukiapi.site
MEOW_API_KEY=
